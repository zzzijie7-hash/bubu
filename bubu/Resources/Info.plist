<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleName</key>
    <string>步步</string>
    <key>CFBundleDisplayName</key>
    <string>步步 Bubu</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>location-services</string>
        <string>gps</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>

    <!-- 隐私权限说明 -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>步步需要访问你的位置，用于在地图上展示附近的地点和标记你去过的地方。</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>步步需要在后台访问你的位置，以便在你到达想去的地点时提醒你。</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>步步需要访问你的相册，用于为打卡地点添加照片和识别截图中的地点信息。</string>
    <key>NSCameraUsageDescription</key>
    <string>步步需要使用相机，用于拍摄打卡照片。</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>步步需要使用麦克风，用于录制语音打卡。</string>
    <key>UIPasteboardUsageDescription</key>
    <string>步步需要读取剪贴板，用于识别你复制的小红书分享链接。</string>

    <!-- URL Scheme -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.bubu.app</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>bubu</string>
            </array>
        </dict>
    </array>

    <!-- 高德 API Key (构建时替换) -->
    <key>AMAP_API_KEY</key>
    <string>$(AMAP_API_KEY)</string>

    <!-- CloudKit (v2.0 启用) -->

    <!-- 后台模式 -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>
</dict>
</plist>